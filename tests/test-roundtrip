#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SAMPLE="${1:-$SCRIPT_DIR/samples/example.xml}"
DIR=/tmp/confetti
mkdir -p "$DIR"
BASE="$(basename "${SAMPLE%.*}")"
MD="$DIR/$BASE.md"
RT="$DIR/$BASE.rt.xml"

confetti to-md "$SAMPLE" -o "$MD"
confetti to-xhtml "$MD" -o "$RT"
diff "$SAMPLE" "$RT" && echo "OK: $SAMPLE roundtrips cleanly"
